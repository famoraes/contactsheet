{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContactSheet",
  "version": "0.1.0",
  "identifier": "com.contactsheet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ContactSheet",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "The ContactSheet Authors",
    "copyright": "Copyright 2026 The ContactSheet Authors. Licensed under the Apache License 2.0.",
    "category": "Photography",
    "shortDescription": "Film negative to positive converter",
    "longDescription": "Converts linear film scans (TIFF) and camera scans (RAW/DNG) of negatives into positives, roll by roll: automatic conversion, crop and AutoCrop, metadata, hot folder and export.",
    "license": "Apache-2.0",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
      "../licenses/LGPL-2.1.txt": "licenses/LGPL-2.1.txt"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
